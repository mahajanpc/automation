# ==============================================================
# Daily Telugu Health Reel Automation Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to GitHub or any public repository!
# ==============================================================

# 1. Google Gemini API (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Free Stock Video API (Pixabay is recommended because Pexels paused new keys)
# Get your instant free key: Sign up at https://pixabay.com then visit https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Optional: Pexels API (if you already have an existing key)
PEXELS_API_KEY=your_pexels_api_key_here

# 3. Cloudinary (Free tier from https://cloudinary.com/)
# Used to host video temporarily so you can view/download via link
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# 4. Email Notification (Sends review emails with video to your inbox)
# If using Gmail, generate an 'App Password' from Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_sender_email@gmail.com
SMTP_PASSWORD=your_gmail_16_digit_app_password
RECIPIENT_EMAIL=your_destination_email@gmail.com

# 5. Instagram Graph API (Meta for Developers) - Required only when you want direct auto-publishing
INSTAGRAM_ACCOUNT_ID=your_instagram_business_or_creator_account_id
IG_ACCESS_TOKEN=your_long_lived_user_access_token

# 6. Bot Settings
# Telugu Voice choices: te-IN-ShrutiNeural (Female - Recommended) or te-IN-MohanNeural (Male)
VOICE_NAME=te-IN-ShrutiNeural
TARGET_DURATION_SECONDS=30
SUBTITLE_FONT=Noto Sans Telugu

# Execution Mode:
# 'review'  = Generates 30s video, emails it to you with caption for manual check & post (RECOMMENDED)
# 'publish' = Automatically publishes directly to Instagram
EXECUTION_MODE=review
